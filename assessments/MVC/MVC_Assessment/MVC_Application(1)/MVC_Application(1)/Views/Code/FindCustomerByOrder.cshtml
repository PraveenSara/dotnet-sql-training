@model MVC_Application_1_.Models.Customer
@{
    ViewBag.Title = "FindCustomerByOrder";
}

<h2>Find Customer By Order</h2>

@if (Model != null)
{
    <table border="1">

        <tr>
            <td>Customer ID</td>
            <td>@Model.CustomerID</td>
        </tr>

        <tr>
            <td>Company Name</td>
            <td>@Model.CompanyName</td>
        </tr>

        <tr>
            <td>Contact Name</td>
            <td>@Model.ContactName</td>
        </tr>

        <tr>
            <td>Country</td>
            <td>@Model.Country</td>
        </tr>

        <tr>
            <td>City</td>
            <td>@Model.City</td>
        </tr>

    </table>
}
else
{
    <h3>No Customer Found</h3>
}